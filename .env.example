APP_PORT=8443

# Optional LanguageTool Java heap settings
# Increase these if LanguageTool crashes with OutOfMemoryError
LT_JAVA_XMS=512m
LT_JAVA_XMX=1g

# Optional LanguageTool API settings
# Leave API_KEY empty to auto-generate one on first startup
LT_API_KEY=
LT_REQUIRE_API_KEY=true

# Optional OpenID Connect login
OIDC_ENABLED=false
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=https://localhost:8443/api/auth/oidc/callback
OIDC_SUCCESS_REDIRECT=/
OIDC_DISPLAY_NAME=Sign in with SSO
OIDC_SCOPE=openid profile email
OIDC_IDENTITY_CLAIM=sub
OIDC_JIT_ENABLED=false
OIDC_ROLE_CLAIM=roles
# Ordered JSON mappings; the first matching external value wins.
# Example: [{"external":"company-admin","internal":"admin"},{"external":"company-user","internal":"user"}]
OIDC_ROLE_MAPPINGS=
# Simple defaults used when OIDC_ROLE_MAPPINGS is empty
OIDC_ADMIN_ROLE=admin
OIDC_USER_ROLE=user
OIDC_GROUP_CLAIM=groups
OIDC_GROUP_MAPPINGS=
OIDC_ADMIN_GROUP=
OIDC_USER_GROUP=
OIDC_REAUTH_INTERVAL_MINUTES=480
