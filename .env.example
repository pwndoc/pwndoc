APP_PORT=8443

# Optional LanguageTool Java heap settings
# Increase these if LanguageTool crashes with OutOfMemoryError
LT_JAVA_XMS=512m
LT_JAVA_XMX=1g

# Optional LanguageTool API settings
# Leave API_KEY empty to auto-generate one on first startup
LT_API_KEY=
LT_REQUIRE_API_KEY=true

# Optional outgoing webhooks
# Use a URL reachable from the backend container and a randomly generated secret.
PWNDOC_WEBHOOK_URL=
PWNDOC_WEBHOOK_SECRET=
PWNDOC_WEBHOOK_EVENTS=audit.updated,audit.state.changed
PWNDOC_WEBHOOK_TIMEOUT_MS=5000
