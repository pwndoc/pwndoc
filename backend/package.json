{
  "name": "pwndoc-backend",
  "version": "0.0.1",
  "description": "pwndoc backend",
  "productName": "pwndoc",
  "author": "Stanley HAMMER",
  "scripts": {
    "start": "node src/app.js",
    "dev": "NODE_ENV=dev nodemon --ext js src/app.js",
    "generate-api-doc": "node swagger-autogen.js",
    "prod": "NODE_ENV=prod nodemon src/app.js",
    "test:api": "NODE_ENV=test jest tests/index.test.js --testTimeout=10000 --forceExit",
    "test:api:coverage": "NODE_ENV=test jest tests/index.test.js --coverage --testTimeout=10000 --forceExit",
    "test:server": "NODE_ENV=test nodemon --ext js src/app.js"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/preset-env": "^7.29.14",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.2"
  },
  "dependencies": {
    "@node-llm/core": "^1.20.1",
    "ae-cvss-calculator": "^1.0.13",
    "angular-expressions": "^1.7.2",
    "archiver": "^7.0.1",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "docx": "^9.15.3",
    "docxtemplater": "^3.71.1",
    "docxtemplater-image-module-pwndoc": "github:pwndoc/docxtemplater-image-module-pwndoc",
    "express": "^5.3.0",
    "full-icu": "^1.6.0",
    "highlight.js": "^11.12.0",
    "htmlparser2": "^10.1.0",
    "image-size": "^2.1.0",
    "JSONStream": "^1.3.5",
    "jsonwebtoken": "^9.0.3",
    "lodash": "^4.18.1",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "otpauth": "^9.6.0",
    "pizzip": "^3.3.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "swagger-autogen": "^2.23.7",
    "tar-stream": "^3.2.2",
    "xml": "^1.0.1",
    "xml2js": "^0.6.2"
  }
}
