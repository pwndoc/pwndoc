{
  "name": "pwndoc-frontend",
  "version": "1.0.0",
  "description": "pwndoc frontend",
  "productName": "pwndoc",
  "cordovaId": "org.cordova.quasar.app",
  "author": "Stanley Hammer",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "export NODE_OPTIONS=--openssl-legacy-provider && quasar build",
    "dev": "export NODE_OPTIONS=--openssl-legacy-provider && quasar dev",
    "test": "vitest --config ./tests/unit/vitest.config.js",
    "test:ui": "vitest --config ./tests/unit/vitest.config.js --ui",
    "test:coverage": "vitest --config ./tests/unit/vitest.config.js --coverage run && node ./tests/unit/generate-coverage-threshold-report.mjs",
    "test:run": "vitest --config ./tests/unit/vitest.config.js run"
  },
  "dependencies": {
    "@quasar/extras": "^1.18.0",
    "@tiptap/extension-code-block-lowlight": "^2.27.3",
    "@tiptap/extension-highlight": "^2.27.3",
    "@tiptap/extension-image": "^2.27.3",
    "@tiptap/extension-underline": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "@tiptap/vue-3": "^2.27.3",
    "ae-cvss-calculator": "^1.0.13",
    "axios": "^0.18.1",
    "core-js": "^3.51.0",
    "diff": "^8.0.4",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "idb": "^8.0.4",
    "js-yaml": "^4.3.2",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "lowlight": "^3.3.0",
    "pinia": "^3.0.4",
    "quasar": "2.35.4",
    "socket.io-client": "^4.8.4",
    "vue": "3.5.45",
    "vue-i18n": "^11.4.19",
    "vue-router": "4.6.5",
    "vue3-sticky-directive": "^0.0.2",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@quasar/app-webpack": "^4.4.5",
    "@quasar/cli": "^2.5.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vitest/coverage-v8": "^4.1.12",
    "@vue/test-utils": "^2.5.1",
    "autoprefixer": "^10.6.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^27.4.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.14.12",
    "yarn": ">= 1.17.3"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not ie <= 10"
  ]
}
